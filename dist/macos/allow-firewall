#!/bin/bash

# This script tells the macOS application firewall to allow incoming connections for the
# GameController, so that no dialog interrupts the first start (e.g. on a machine that is set up
# before an event). It asks for the administrator password. It is in the app bundle
# (Contents/Resources/allow-firewall) and can be run from a terminal.

app="${1:-/Applications/GameController.app}"
if [ ! -d "${app}" ]; then
  >&2 echo "${app} not found. Copy the GameController to /Applications first."
  exit 1
fi

# The firewall keeps its entries per executable (that is what its dialog and --listapps use), so
# the path to the executable in the bundle is needed here, not the one of the bundle.
executable="${app}/Contents/MacOS/GameController"
firewall=/usr/libexec/ApplicationFirewall/socketfilterfw
sudo "${firewall}" --add "${executable}" && sudo "${firewall}" --unblockapp "${executable}"
