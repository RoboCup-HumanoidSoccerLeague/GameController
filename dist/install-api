#!/bin/bash

set -e

destdir=${1}
target=${2}
profile=release-dist

if [ -z ${destdir} ]; then
  >&2 echo "usage: ${0} <destdir> [<target>]"
  exit 1
fi

basedir="$(cd "$(dirname "$(which "${0}")")" && pwd)/.."

# Without a target, the library is built for the host, except on macOS, where it is universal.
universal=false
if [ -z ${target} ]; then
  target="$(rustc -vV | sed -n "s/^host: \(.*\)/\1/p")"
  case "${target}" in
    *-apple-darwin) universal=true ;;
  esac
fi

case "${target}" in
  *-apple-darwin) library=libgame_controller_api.dylib ;;
  *) library=libgame_controller_api.so ;;
esac

pushd "${basedir}"
if ${universal}; then
  cargo build --target aarch64-apple-darwin --profile "${profile}" --package game_controller_api
  cargo build --target x86_64-apple-darwin --profile "${profile}" --package game_controller_api
else
  cargo build --target "${target}" --profile "${profile}" --package game_controller_api
fi
popd

mkdir -p "${destdir}/include"
mkdir -p "${destdir}/lib"
mkdir -p "${destdir}/config"

cp "${basedir}/LICENSE" "${destdir}"
cp "${basedir}/game_controller_api/headers/GameController.h" "${destdir}/include"
cp "${basedir}/game_controller_msgs/headers/RoboCupGameControlData.h" "${destdir}/include"
if ${universal}; then
  lipo -create -output "${destdir}/lib/${library}" "${basedir}/target/aarch64-apple-darwin/${profile}/${library}" "${basedir}/target/x86_64-apple-darwin/${profile}/${library}"
else
  cp "${basedir}/target/${target}/${profile}/${library}" "${destdir}/lib"
fi
for dir in "${basedir}"/config/*; do
  [ -f "${dir}/params.yaml" ] || continue
  cp "${dir}/params.yaml" "${destdir}/config/$(basename "${dir}").yaml"
done
